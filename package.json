{
  "name": "pdf-translate",
  "displayName": "PDF Viewer with Translate",
  "description": "Read PDFs in VS Code, then select text, right-click and translate it in place.",
  "version": "0.1.0",
  "publisher": "hiepbk",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "pdf",
    "viewer",
    "translate",
    "translation",
    "vietnamese"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hiepbk/pdf-translate-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/hiepbk/pdf-translate-vscode/issues"
  },
  "activationEvents": [
    "onCustomEditor:pdfTranslate.preview"
  ],
  "main": "./out/src/extension",
  "contributes": {
    "capabilities": {
      "untrustedWorkspaces": {
        "supported": true
      }
    },
    "customEditors": [
      {
        "viewType": "pdfTranslate.preview",
        "displayName": "PDF Viewer with Translate",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "pdf-translate.setDeepLApiKey",
        "title": "Set DeepL API Key",
        "category": "PDF Translate"
      },
      {
        "command": "pdf-translate.clearDeepLApiKey",
        "title": "Clear DeepL API Key",
        "category": "PDF Translate"
      },
      {
        "command": "pdf-translate.selectTargetLanguage",
        "title": "Select Target Language",
        "category": "PDF Translate"
      },
      {
        "command": "pdf-translate.selectSourceLanguage",
        "title": "Select Source Language",
        "category": "PDF Translate"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "PDF Viewer with Translate",
      "properties": {
        "pdf-translate.provider": {
          "markdownDescription": "Translation backend.\n\n- `google` needs no account and works immediately. It uses an undocumented Google endpoint, so it can rate-limit or change without notice.\n- `deepl` uses the official DeepL API. Better prose, but it needs an API key: run **PDF Translate: Set DeepL API Key**.",
          "type": "string",
          "default": "google",
          "enum": [
            "google",
            "deepl"
          ],
          "enumDescriptions": [
            "Google Translate — no account, no API key",
            "DeepL — requires an API key"
          ]
        },
        "pdf-translate.targetLanguage": {
          "markdownDescription": "Language to translate into. DeepL supports fewer languages than Google; the popup’s picker only offers the ones the selected backend accepts.",
          "type": "string",
          "default": "vi",
          "enum": [
            "ar",
            "bg",
            "zh",
            "cs",
            "da",
            "nl",
            "en",
            "et",
            "fi",
            "fr",
            "de",
            "el",
            "he",
            "hi",
            "hu",
            "id",
            "it",
            "ja",
            "ko",
            "lv",
            "lt",
            "no",
            "fa",
            "pl",
            "pt",
            "ro",
            "ru",
            "sk",
            "sl",
            "es",
            "sv",
            "th",
            "tr",
            "uk",
            "vi"
          ],
          "enumDescriptions": [
            "Arabic",
            "Bulgarian",
            "Chinese",
            "Czech",
            "Danish",
            "Dutch",
            "English",
            "Estonian",
            "Finnish",
            "French",
            "German",
            "Greek",
            "Hebrew",
            "Hindi",
            "Hungarian",
            "Indonesian",
            "Italian",
            "Japanese",
            "Korean",
            "Latvian",
            "Lithuanian",
            "Norwegian",
            "Persian",
            "Polish",
            "Portuguese",
            "Romanian",
            "Russian",
            "Slovak",
            "Slovenian",
            "Spanish",
            "Swedish",
            "Thai",
            "Turkish",
            "Ukrainian",
            "Vietnamese"
          ]
        },
        "pdf-translate.sourceLanguage": {
          "markdownDescription": "Language of the PDF. `auto` lets the backend detect it, which is convenient but slightly less accurate than naming the language, especially for short selections or documents that mix languages.",
          "type": "string",
          "default": "en",
          "enum": [
            "auto",
            "ar",
            "bg",
            "zh",
            "cs",
            "da",
            "nl",
            "en",
            "et",
            "fi",
            "fr",
            "de",
            "el",
            "he",
            "hi",
            "hu",
            "id",
            "it",
            "ja",
            "ko",
            "lv",
            "lt",
            "no",
            "fa",
            "pl",
            "pt",
            "ro",
            "ru",
            "sk",
            "sl",
            "es",
            "sv",
            "th",
            "tr",
            "uk",
            "vi"
          ],
          "enumDescriptions": [
            "Auto-detect",
            "Arabic",
            "Bulgarian",
            "Chinese",
            "Czech",
            "Danish",
            "Dutch",
            "English",
            "Estonian",
            "Finnish",
            "French",
            "German",
            "Greek",
            "Hebrew",
            "Hindi",
            "Hungarian",
            "Indonesian",
            "Italian",
            "Japanese",
            "Korean",
            "Latvian",
            "Lithuanian",
            "Norwegian",
            "Persian",
            "Polish",
            "Portuguese",
            "Romanian",
            "Russian",
            "Slovak",
            "Slovenian",
            "Spanish",
            "Swedish",
            "Thai",
            "Turkish",
            "Ukrainian",
            "Vietnamese"
          ]
        },
        "pdf-translate.cleanText": {
          "markdownDescription": "Repair text taken from the PDF before translating it: rejoin lines broken mid-sentence, undo end-of-line hyphenation, and normalise ligatures, quotes and spacing. Turning this off sends the selection exactly as the PDF text layer reports it, which usually translates poorly.",
          "type": "boolean",
          "default": true
        },
        "pdf-translate.removeHeadersFooters": {
          "markdownDescription": "While cleaning, also drop running headers, footers, page numbers and similar page furniture that falls inside a selection spanning a page break. Only applies when `#pdf-translate.cleanText#` is enabled.",
          "type": "boolean",
          "default": true
        },
        "pdf-translate.showOriginal": {
          "markdownDescription": "Include the cleaned source text in the translation popup, in a collapsible section.",
          "type": "boolean",
          "default": true
        },
        "pdf-translate.timeout": {
          "markdownDescription": "How long to wait for the translation backend, in milliseconds.",
          "type": "number",
          "default": 15000,
          "minimum": 1000
        },
        "pdf-translate.default.cursor": {
          "markdownDescription": "The default cursor tool for preview.",
          "type": "string",
          "default": "select",
          "enum": [
            "select",
            "hand"
          ]
        },
        "pdf-translate.default.scale": {
          "markdownDescription": "The default zoom level for preview. Allowed values are `auto`, `page-actual`, `page-fit`, `page-width`, and 1-based scale values. (`1.0` means 100%)",
          "type": "string",
          "default": "auto",
          "pattern": "^(\\d+(?:\\.\\d+)?|auto|page-actual|page-fit|page-width)$"
        },
        "pdf-translate.default.sidebar": {
          "markdownDescription": "Show the sidebar on load. The default visibility of sidebar for preview.",
          "type": "boolean",
          "default": false
        },
        "pdf-translate.default.scrollMode": {
          "markdownDescription": "The default scroll mode for preview.",
          "type": "string",
          "default": "vertical",
          "enum": [
            "vertical",
            "horizontal",
            "wrapped"
          ]
        },
        "pdf-translate.default.spreadMode": {
          "markdownDescription": "The default spread mode for preview.",
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "odd",
            "even"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint -c .eslintrc.json --ext .ts ./src",
    "test:unit": "mocha out/src/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^16.18.0",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "mocha": "^10.1.0",
    "prettier": "^2.0.4",
    "typescript": "^4.9.5",
    "vsce": "^2.15.0",
    "vscode-dts": "^0.3.1",
    "vscode-test": "^1.3.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
